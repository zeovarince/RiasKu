# API Laravel yang diakses browser
VITE_API_BASE_URL=http://localhost:8000/api

# true = memakai data mock dari src/services/mockData.js
# false = mengambil data kategori dan produk dari Laravel API
VITE_USE_MOCK_DATA=true

# true = sinkronkan cart dengan Laravel jika user sudah memiliki Bearer token
# membutuhkan endpoint GET/POST/PATCH/DELETE /api/cart
VITE_CART_API_ENABLED=false
